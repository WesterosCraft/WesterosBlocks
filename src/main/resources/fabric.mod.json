{
  "schemaVersion": 1,
  "id": "westerosblocks",
  "version": "${version}",
  "name": "WesterosBlocks",
  "description": "A Song Of Ice and Fire themed blocks for a medieval world",
  "authors": ["geeberry", "Emoticone11", "mikeprimm"],
  "contact": {
    "homepage": "https://www.westeroscraft.com",
    "sources": "https://github.com/WesterosCraft/WesterosBlocks"
  },
  "license": "CC0-1.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.westerosblocks.WesterosBlocks"],
    "fabric-datagen": ["com.westerosblocks.WesterosBlocksDataGenerator"],
    "client": ["com.westerosblocks.WesterosBlocksClient"]
  },
  "mixins": ["westerosblocks.mixins.json"],
  "accessWidener": "westerosblocks.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "azurelib": "*",
    "shield_api": "*"
  },
  "suggests": {
    "polytone": "*",
    "westeroscontinuity": "*"
  }
}
