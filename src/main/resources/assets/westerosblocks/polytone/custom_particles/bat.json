{
  "render_type": "translucent",
  "has_physics": true,
  "kill_when_still": false,
  "kill_on_contact": false,
  "random_sprite": false,
  "rotation_mode": "look_at_xyz",
  "liquid_affinity": "non_liquids",

  "initializer": {
    "lifetime": "(50 + rand() * 30) * 1.1",
    "size": "0.25 + rand() * 0.05",
    "alpha": "0.9",
    "friction": "0.94",
    "dx": "(rand() - 0.5) * 0.15",
    "dy": "(rand() - 0.5) * 0.10",
    "dz": "(rand() - 0.5) * 0.15",
    "roll": "0",
    "custom": "rand() * 6.28"
  },

  "ticker": {
    "dx": "DX + 0.006 * (cos(AGE * 0.18 + CUSTOM) + 0.4 * cos(AGE * 0.37 + CUSTOM * 2)) + gaussian() * 0.003",
    "dy": "DY + 0.005 * (sin(AGE * 0.22 + CUSTOM * 0.5) + 0.6 * sin(AGE * 0.43)) + gaussian() * 0.002",
    "dz": "DZ + 0.006 * (sin(AGE * 0.18 + CUSTOM * 1.5) + 0.4 * sin(AGE * 0.37 + CUSTOM)) + gaussian() * 0.003",
    "size": "(0.9 + CUSTOM * 0.2) * 0.18 * min(max(AGE / 4, 0), 1) * (1 - min(max((AGE - LIFETIME + 4) / 4, 0), 1))"
  }
}
