{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/glass_pane/glass_pane_post"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/glass_pane/glass_pane_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/glass_pane/glass_pane_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/glass_pane/glass_pane_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/glass_pane/glass_pane_noside",
        "y": 90
      },
      "when": {
        "east": "false"
      }
    }
  ]
}