{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/oxidized_iron_crossbar/oxidized_iron_crossbar_post"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/oxidized_iron_crossbar/oxidized_iron_crossbar_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/oxidized_iron_crossbar/oxidized_iron_crossbar_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/oxidized_iron_crossbar/oxidized_iron_crossbar_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/oxidized_iron_crossbar/oxidized_iron_crossbar_noside",
        "y": 90
      },
      "when": {
        "east": "false"
      }
    }
  ]
}