{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/orange_slate_fence/post"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_slate_fence/side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_slate_fence/side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_slate_fence/side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_slate_fence/side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}