{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/post_v1"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_v1"
      },
      "when": {
        "north": "low"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_v1",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "low"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_v1",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "low"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_v1",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "low"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_tall_v1"
      },
      "when": {
        "north": "tall"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_tall_v1",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "tall"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_tall_v1",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "tall"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/orange_wood_vertical_planks_wall/side_tall_v1",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "tall"
      }
    }
  ]
}