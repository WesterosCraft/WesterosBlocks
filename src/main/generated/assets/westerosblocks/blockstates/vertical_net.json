{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/vertical_net_post"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/vertical_net_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/vertical_net_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/vertical_net_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/vertical_net_noside",
        "y": 90
      },
      "when": {
        "east": "false"
      }
    }
  ]
}