      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_green/stained_glass_pane_green_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_green/stained_glass_pane_green_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_green/stained_glass_pane_green_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_green/stained_glass_pane_green_noside",
        "y": 90
      },
      "when": {
        "east": "false"
      }
    }
