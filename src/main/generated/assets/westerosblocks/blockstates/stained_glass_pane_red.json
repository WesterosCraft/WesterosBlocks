{
  "multipart": [
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_red/stained_glass_pane_red_post"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_red/stained_glass_pane_red_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_red/stained_glass_pane_red_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_red/stained_glass_pane_red_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "westerosblocks:block/stained_glass_pane_red/stained_glass_pane_red_noside",
        "y": 90
      },
      "when": {
        "east": "false"
      }
    }
  ]
}